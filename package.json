{
  "name": "clara-gitlab",
  "version": "0.1.0",
  "private": true,
  "description": "CLARA for the GitLab wiki — self-contained install bundle built from dsta-productops/clara.",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build-gitlab.ts",
